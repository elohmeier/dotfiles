{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "service-red-overview-v2"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Operational RED dashboard example. Adapt metric names, labels, SLO thresholds, freshness limits, ownership, and drilldowns before use.",
    "editable": true,
    "elements": {
      "panel-purpose": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Purpose and operating contract",
          "description": "States audience, task, freshness, failure semantics, and required adaptation for this example.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "**Audience:** service on-call. **Task:** identify user impact, affected service, and supporting trend without losing scope or time. **Freshness contract:** samples older than 2 minutes are concerning and older than 5 minutes are critical. **No data is not zero or healthy.**\n\nBefore production use, replace the example metric names, `service` label, thresholds, owner, runbook, and logs/traces links. Error and latency thresholds below are examples, not universal defaults."
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-request-rate": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Request rate",
          "description": "Current request throughput for the selected services. A valid zero means no requests; no data means no matching samples and must be investigated separately.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(http_requests_total{service=~\"${service:regex}\"}[$__rate_interval]))",
                        "legendFormat": "requests/s",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "decimals": 2,
                  "noValue": "No matching samples",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-error-ratio": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "5xx error ratio",
          "description": "Current server-error ratio. Example thresholds are 1% concerning and 5% critical; replace them with the service SLO or user-impact boundary.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum(rate(http_requests_total{service=~\"${service:regex}\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_requests_total{service=~\"${service:regex}\"}[$__rate_interval])), 1e-9)",
                        "legendFormat": "5xx ratio",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "value_and_name",
                "colorMode": "background",
                "graphMode": "area"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "decimals": 2,
                  "noValue": "No matching samples",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.01,
                        "color": "yellow"
                      },
                      {
                        "value": 0.05,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-p95-latency": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "p95 latency",
          "description": "Current p95 request latency. Example thresholds are 500 ms concerning and 1 s critical; replace them with the service SLO or user-impact boundary.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"${service:regex}\"}[$__rate_interval])) by (le))",
                        "legendFormat": "p95",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "value_and_name",
                "colorMode": "background",
                "graphMode": "area"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "decimals": 3,
                  "noValue": "No histogram samples",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.5,
                        "color": "yellow"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-freshness": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Newest sample age",
          "description": "Seconds since the newest matching request-counter sample. Example freshness contract: over 2 minutes is concerning and over 5 minutes is critical. No data means freshness cannot be established.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "time() - max(timestamp(http_requests_total{service=~\"${service:regex}\"}))",
                        "legendFormat": "sample age",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "value_and_name",
                "colorMode": "background",
                "graphMode": "none"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "decimals": 0,
                  "noValue": "Freshness unknown",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 120,
                        "color": "yellow"
                      },
                      {
                        "value": 300,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-rate-by-service": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Request rate by service",
          "description": "Compares selected services on one request-per-second scale. A missing series is not the same as a service reporting a valid zero.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(http_requests_total{service=~\"${service:regex}\"}[$__rate_interval])) by (service)",
                        "legendFormat": "{{service}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "decimals": 2,
                  "noValue": "No matching samples",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "fillOpacity": 8,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-error-by-service": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "5xx error ratio by service",
          "description": "Compares selected services on one percentage scale to identify the affected service. Missing series remain gaps rather than being coerced to zero.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum(rate(http_requests_total{service=~\"${service:regex}\",status=~\"5..\"}[$__rate_interval])) by (service) or 0 * sum(rate(http_requests_total{service=~\"${service:regex}\"}[$__rate_interval])) by (service)) / clamp_min(sum(rate(http_requests_total{service=~\"${service:regex}\"}[$__rate_interval])) by (service), 1e-9)",
                        "legendFormat": "{{service}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "decimals": 2,
                  "min": 0,
                  "noValue": "No matching samples",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "fillOpacity": 5,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.01,
                        "color": "yellow"
                      },
                      {
                        "value": 0.05,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-latency-percentiles": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Latency percentiles",
          "description": "Shows p50, p95, and p99 request latency over time for the selected service scope. Percentiles are computed from histogram buckets, not averaged from precomputed percentiles.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=~\"${service:regex}\"}[$__rate_interval])) by (le))",
                        "legendFormat": "p50",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"${service:regex}\"}[$__rate_interval])) by (le))",
                        "legendFormat": "p95",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=~\"${service:regex}\"}[$__rate_interval])) by (le))",
                        "legendFormat": "p99",
                        "range": true
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "decimals": 3,
                  "min": 0,
                  "noValue": "No histogram samples",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "fillOpacity": 5,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Status",
              "collapse": false,
              "hideHeader": false,
              "fillScreen": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 4,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-purpose"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 4,
                        "width": 6,
                        "height": 5,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-request-rate"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 6,
                        "y": 4,
                        "width": 6,
                        "height": 5,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-error-ratio"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 12,
                        "y": 4,
                        "width": 6,
                        "height": 5,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-p95-latency"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 18,
                        "y": 4,
                        "width": 6,
                        "height": 5,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-freshness"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Correlated trends",
              "collapse": false,
              "hideHeader": false,
              "fillScreen": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "tall",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-rate-by-service"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-error-by-service"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-latency-percentiles"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "example",
      "prometheus",
      "red"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Service RED overview",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Prometheus datasource",
          "hide": "dontHide",
          "skipUrlSync": false,
          "description": "Prometheus-compatible datasource used by every panel and variable query.",
          "allowCustomValue": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "service",
          "current": {
            "text": "All",
            "value": [
              "$__all"
            ]
          },
          "label": "Service",
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "description": "Service label scope. Bound the available values before using this example with high-cardinality metrics.",
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${datasource}"
            },
            "spec": {
              "__legacyStringValue": "label_values(http_requests_total, service)"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(http_requests_total, service)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "allowCustomValue": false
        }
      }
    ]
  }
}
