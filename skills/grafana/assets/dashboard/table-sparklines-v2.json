{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "table-sparklines-example"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-table-sparklines": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Service request trends",
          "description": "One row per series. The Time series to table transformation creates the frame-valued Trend #A field used by the sparkline cell.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (service) (rate(http_requests_total[$__rate_interval]))",
                        "legendFormat": "{{service}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "timeSeriesTable",
                  "spec": {
                    "options": {
                      "A": {
                        "stat": "lastNotNull"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {
                "maxDataPoints": 60
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "cellHeight": "sm",
                "enablePagination": true,
                "frozenColumns": {
                  "left": 1
                },
                "sortBy": [
                  {
                    "displayName": "Trend",
                    "desc": true
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false,
                    "minWidth": 90
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Trend #A"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Trend"
                      },
                      {
                        "id": "unit",
                        "value": "reqps"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      },
                      {
                        "id": "custom.width",
                        "value": 300
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "sparkline",
                          "drawStyle": "line",
                          "lineInterpolation": "smooth",
                          "lineWidth": 1,
                          "fillOpacity": 17,
                          "gradientMode": "hue",
                          "showPoints": "never",
                          "hideValue": false
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-stat-sparkline": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Current request rate",
          "description": "The displayed number is lastNotNull while the area sparkline retains the original range field.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(http_requests_total[$__rate_interval]))",
                        "legendFormat": "requests/s",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 100
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "reduceOptions": {
                  "values": false,
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "value",
                "graphMode": "area"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "decimals": 2,
                  "noValue": "No samples",
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 18,
              "height": 12,
              "element": {
                "kind": "ElementReference",
                "name": "panel-table-sparklines"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 18,
              "y": 0,
              "width": 6,
              "height": 12,
              "element": {
                "kind": "ElementReference",
                "name": "panel-stat-sparkline"
              }
            }
          }
        ]
      }
    },
    "links": [],
    "preload": false,
    "tags": [
      "example",
      "table",
      "sparkline"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Table and stat sparklines",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Prometheus datasource",
          "hide": "dontHide",
          "skipUrlSync": false,
          "description": "Prometheus-compatible datasource used by both sparkline examples.",
          "allowCustomValue": false
        }
      }
    ]
  }
}
