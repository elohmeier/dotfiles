# vim: ft=toml

[user]
email = "{{ .email }}"
name = "{{ .name }}"

[merge-tools.diffconflicts]
program = "nvim"
merge-args = [
  "-c",
  "let g:jj_diffconflicts_marker_length=$marker_length",
  "-c",
  "JJDiffConflicts!",
  "$output",
  "$base",
  "$left",
  "$right",
]
merge-tool-edits-conflict-markers = true


[ui]
default-command = "st"
diff-formatter = ":git"
pager = ["{{ lookPath "hunk" | default "hunk" }}", "pager"]
