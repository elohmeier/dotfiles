alias gaapf 'git add . && git commit --amend --no-edit && git push --force-with-lease'
alias ww 'git add . && git commit -m wip'
alias gapf 'git commit --amend --no-edit && git push --force-with-lease'
alias gg lazygit
alias grep 'grep --color'
alias lgg lazygit
alias nbconvert 'jupyter nbconvert --to script --stdout'

{{- if lookPath "eza" }}
    alias l 'eza -al'
    alias la 'eza -al'
    alias lg 'eza -al --git'
    alias ll 'eza -l'
    alias ls eza
    alias tree 'eza --tree'
{{- else }}
    alias l 'ls -al'
    alias la 'ls -al'
    alias ll 'ls -l'
{{- end }}
{{- if lookPath "nvim" }}
    alias vi nvim
    alias vim nvim
{{- end }}
alias djust "just --justfile $HOME/.config/just/dotfiles.just"

{{- if and (not (lookPath "nix")) (lookPath "orb") }}
    alias nix 'orb -m nixos nix --extra-experimental-features "nix-command flakes"'
{{- end }}

{{- if lookPath "apk" }}
    alias au 'apk update'
    alias aug 'apk update && apk upgrade'
    alias ai 'apk add'
    alias as 'apk search'
{{- end }}
{{- if lookPath "lbu" }}
    alias lc 'lbu commit'
    alias lst 'lbu status'
{{- end }}
