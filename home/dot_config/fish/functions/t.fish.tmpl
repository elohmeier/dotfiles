function t -d "Create or attach to a tmux session"
    set -l session (if test (count $argv) -gt 0; echo $argv[1]; else; echo {{ .chezmoi.hostname }}; end)
    test -n "$TMUX"; and return 0
    if test -n "$SSH_AUTH_SOCK"
        test "$SSH_AUTH_SOCK" = "$HOME/.ssh/agent.sock"; or ln -sfn "$SSH_AUTH_SOCK" ~/.ssh/agent.sock
        set -gx SSH_AUTH_SOCK "$HOME/.ssh/agent.sock"
        tmux set-environment -g SSH_AUTH_SOCK "$SSH_AUTH_SOCK" 2>/dev/null
        tmux set-environment -t "$session" SSH_AUTH_SOCK "$SSH_AUTH_SOCK" 2>/dev/null
    end
    if tmux has-session -t "$session" 2>/dev/null
        tmux attach-session -t "$session"
    else
{{- if and (eq .chezmoi.os "darwin") (lookPath "security") }}
        if not security show-keychain-info ~/Library/Keychains/login.keychain-db &>/dev/null
            security unlock-keychain ~/Library/Keychains/login.keychain-db; or return 1
        end
{{- end }}
        tmux new-session -s "$session"
    end
end
