{{/* vim: set filetype=fish: */}}
{{- $theme := includeTemplate "theme" . -}}
if status is-interactive
  # Ghostty shell integration emits OSC 133 prompt markers; disable Fish's
  # native duplicate to prevent newlines being swallowed when copying.
  set -gx fish_features $fish_features no-mark-prompt

  set -U fish_greeting
  set -gx EDITOR nvim
  fish_config theme choose "{{ $theme }}"

  # Ensure Homebrew is on PATH
  if test -d /home/linuxbrew/.linuxbrew/bin
    fish_add_path /home/linuxbrew/.linuxbrew/bin /home/linuxbrew/.linuxbrew/sbin
  end
  if test -d /opt/homebrew/bin
    fish_add_path /opt/homebrew/bin /opt/homebrew/sbin
  end
  if test -d /usr/local/bin
    fish_add_path /usr/local/bin /usr/local/sbin
  end

  # Set PNPM_HOME based on OS and add to PATH
{{- if eq .chezmoi.os "darwin" }}
  set -gx PNPM_HOME "$HOME/Library/pnpm"
  set -gx PYTEST_XDIST_AUTO_NUM_WORKERS 4
{{- if lookPath "brew" }}
  fish_add_path (brew --prefix)/opt/rustup/bin
{{- end }}
{{- else }}
  set -gx PNPM_HOME "$HOME/.local/share/pnpm"
{{- end }}

  if not contains "$PNPM_HOME" $PATH
    set -gx PATH "$PNPM_HOME" $PATH
  end

  # Add ~/.local/bin to PATH
  if not contains "$HOME/.local/bin" $PATH
    set -gx PATH "$HOME/.local/bin" $PATH
  end

  # Set bat theme
  set -gx BAT_THEME "{{ $theme }}"

  # Set fzf theme
  set -gx FZF_DEFAULT_OPTS "$FZF_DEFAULT_OPTS --highlight-line --info=inline-right --ansi --layout=reverse --border=none {{ includeTemplate "fzf-theme" . }}"

  # Set LS_COLORS using vivid if available and not already set
{{- if lookPath "vivid" }}
  if not set -q LS_COLORS
    set -Ux LS_COLORS (vivid generate "$HOME/.config/vivid/themes/{{ $theme }}.yaml")
  end
{{- end }}

{{- if .isWSL }}
  # Use wslview as default browser so Python webbrowser.open() works
  set -gx BROWSER wslview

  # Windows Terminal integration for WSL
  function storePathForWindowsTerminal --on-variable PWD
    if test -n "$WT_SESSION"
      printf "\e]9;9;%s\e\\" (wslpath -w "$PWD")
    end
  end

  # Switch to home directory if starting in Windows system32
  if test "$PWD" = "/mnt/c/WINDOWS/system32"
    cd ~
  end
{{- end }}

  source $__fish_config_dir/conf.d/shortcuts.fish

  if test -f $__fish_config_dir/conf.d/fish-ssh-agent.fish
    source $__fish_config_dir/conf.d/fish-ssh-agent.fish
  end

  function h
       set _h_dir ($HOME/.local/bin/h $argv)
       set _h_ret $status
       if test "$_h_dir" != "$PWD"
           cd "$_h_dir"
       end
       return $_h_ret
  end

{{- if lookPath "fzf" }}
  fzf_configure_bindings --directory=\ct
{{- end }}

{{- if lookPath "zoxide" }}
  zoxide init fish | source
{{- end }}

{{- if lookPath "atuin" }}
  atuin init fish | source
{{- end }}

{{- if lookPath "direnv" }}
  direnv hook fish | source
{{- end }}

{{- if lookPath "mise" }}
  mise activate fish | source
{{- end }}

{{- if lookPath "rbenv" }}
  rbenv init - fish | source
{{- end }}

{{- if lookPath "starship" }}
  starship init fish | source
{{- end }}

{{- if .customCABundle }}
  set -gx REQUESTS_CA_BUNDLE "{{ .customCABundle }}"
  set -gx SSL_CERT_FILE "{{ .customCABundle }}"
  set -gx CURL_CA_BUNDLE "{{ .customCABundle }}"
  set -gx UV_NATIVE_TLS "1"
  # dprint TLS configuration
  set -gx DPRINT_CERT "{{ .customCABundle }}"
  set -gx DPRINT_TLS_CA_STORE "system,mozilla"
{{- end }}

{{- if .customPyPIIndex }}
  set -gx UV_INDEX_URL "{{ .customPyPIIndex }}"
  set -gx PIP_INDEX_URL "{{ .customPyPIIndex }}"
{{- end }}
end

# Source Nix profile if it exists
if test -f /nix/var/nix/profiles/default/etc/profile.d/nix.fish
  source /nix/var/nix/profiles/default/etc/profile.d/nix.fish
end

{{- if eq .chezmoi.os "darwin" }}
# Added by OrbStack: command-line tools and integration
# This won't be added again if you remove it.
source ~/.orbstack/shell/init2.fish 2>/dev/null || :
{{- end }}
