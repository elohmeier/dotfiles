#!/usr/bin/env bash
#MISE description="Open a bash shell in the pi container with the same mounts as the pi task"
#MISE raw=true
#MISE dir="{{cwd}}"
set -euo pipefail

# An explicitly empty PI_EGRESS disables filtering; 0 disables recording.
PI_EGRESS="${PI_EGRESS-interactive}"
PI_EGRESS_RECORD="${PI_EGRESS_RECORD-1}"
PI_EGRESS_INSPECT="${PI_EGRESS_INSPECT-all}"

# shellcheck source=tasks/pi/_docker_flags
source "$(dirname "$0")/_docker_flags"

DOCKER_FLAGS+=("--interactive")
[ -t 0 ] && [ -t 1 ] && DOCKER_FLAGS+=("--tty")

# Pass bash as CMD so the entrypoint runs passwd synthesis before dropping to a shell.
"${DOCKER_CMD}" run "${DOCKER_FLAGS[@]}" "${PI_IMAGE}" bash
