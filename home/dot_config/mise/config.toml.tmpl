[settings]
idiomatic_version_file_enable_tools = []
experimental = true

[env]
SOPS_AGE_KEY_FILE = "{{ .chezmoi.homeDir }}/.config/sops/age/keys.txt"
{{- $store := joinPath .chezmoi.homeDir "repos/github.com/elohmeier/password-store" }}
{{- if stat $store }}
PASSWORD_STORE_DIR = "{{ $store }}"
{{- end }}
{{- /* passage takes over once the store has been migrated to age */}}
{{- if stat (joinPath $store ".age-recipients") }}
PASSAGE_DIR = "{{ $store }}"
PASSAGE_IDENTITIES_FILE = "{{ .chezmoi.homeDir }}/.passage/identities"
{{- end }}
