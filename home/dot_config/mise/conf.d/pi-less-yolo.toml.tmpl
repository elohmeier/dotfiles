# Managed by chezmoi — vendored from https://github.com/cjermain/pi-less-yolo (5cd60e6).
# Replaces that repo's `mise run install`; task sources live in ~/.config/pi-less-yolo/tasks.
[task_config]
includes = ["{{ .chezmoi.homeDir }}/.config/pi-less-yolo/tasks"]
{{- if .isWSL }}

[env]
# cgr.dev redirects blob fetches to presigned *.r2.cloudflarestorage.com URLs,
# which the proxy here answers with 403. Docker Hub serves the same digests
# from CloudFront and is reachable.
PI_BASE_REGISTRY = "docker.io"
# Same block hits apk: apk.cgr.dev redirects package downloads to R2, and apk
# turns the resulting 403 into "Permission denied". Wolfi serves the identical
# builds inline.
PI_APK_REPOSITORY = "https://packages.wolfi.dev/os"
{{- with .customCABundle }}
# TLS interception: build the image against the bundle the shell already points
# SSL_CERT_FILE at, so apk, curl, npm and uv trust the proxy.
PI_CA_CERT = {{ . | quote }}
{{- end }}
{{- end }}
