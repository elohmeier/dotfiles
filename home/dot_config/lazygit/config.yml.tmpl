# vim: ft=yaml
# yaml-language-server: $schema=https://raw.githubusercontent.com/jesseduffield/lazygit/master/schema/config.json

gui:
  border: rounded
{{- $themeContent := includeTemplate "lazygit-theme" . -}}
{{- if $themeContent }}
  theme:
{{ $themeContent | indent 4 }}
{{- end }}

customCommands:
  - key: <c-a>
    description: Pick AI commit
    command: aicommit2
    context: files
    output: terminal
  - key: <c-n>
    description: Pick AI commit (no verify)
    command: aicommit2 --no-verify
    context: files
    output: terminal
  - key: D
    description: Add file to DVC
    command: uvx --with dvc-s3 dvc add {{ "{{.SelectedFile.Name}}" }}
    context: files
    output: terminal
