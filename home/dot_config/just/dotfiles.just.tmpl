{{/* vim: set filetype=just: */}}
# Dotfiles task runner - run with: djust <recipe>

default:
    @just --justfile {{"{{"}} justfile() {{"}}"}} --list

{{- if and (lookPath "apk") (lookPath "lbu") }}
diskless-swap-on:
    diskless-swap on

diskless-swap-off:
    diskless-swap off

diskless-swap-status:
    diskless-swap status
{{- end }}

# Install or update agent skills for Claude Code and Codex
install-skills:
    "{{ lookPath "npx" | default "npx" }}" --yes skills add elohmeier/skills --skill '*' --agent claude-code --agent codex --global --yes

# Install Neovim and its language tooling
install-nvim:
    #!/bin/bash
    set -eufo pipefail

    if ! command -v brew &> /dev/null; then
        echo "Homebrew not found. Skipping package installation."
        exit 1
    fi

    brew trust --tap elohmeier/tap hashicorp/tap
    brew bundle --file=/dev/stdin <<'EOF'
    tap "elohmeier/tap"
    tap "hashicorp/tap"
    brew "basedpyright"
    brew "bash-language-server"
    brew "clang-format"
    brew "dprint"
    brew "elohmeier/tap/jsonnet-language-server"
    brew "fd"
    brew "git"
    brew "go-jsonnet"
    brew "hashicorp/tap/packer"
    brew "helm"
    brew "helm-ls"
    brew "imagemagick"
    brew "just"
    brew "lazygit"
    brew "libxml2"
    brew "lua-language-server"
    brew "neovim"
    brew "nixfmt"
    brew "node"
    brew "opentofu"
    brew "ripgrep"
    brew "ruby-lsp"
    brew "ruff"
    brew "rustup"
    brew "shellcheck"
    brew "shfmt"
    brew "stylua"
    brew "taplo"
    brew "terraform-ls"
    brew "tinymist"
    brew "tree-sitter-cli"
    brew "ty"
    brew "typescript-language-server"
    brew "typst"
    brew "typstyle"
    brew "uv"
    brew "yaml-language-server"
    EOF

    npm install -g svelte-language-server
    uv tool install --upgrade djade
    uv tool install --upgrade jupytext
    uv tool install --upgrade rumdl
    "$(brew --prefix ruby)/bin/gem" install --user-install --bindir "$HOME/.local/bin" rubocop
    rustup_bin="$(brew --prefix rustup)/bin"
    export PATH="$rustup_bin:$PATH"
    "$rustup_bin/rustup" default stable
    "$rustup_bin/rustup" component add rust-analyzer
    "$rustup_bin/cargo" install --locked --root "$HOME/.local" puppet-fmt

