{{/* vim: set filetype=just: */}}
# Dotfiles task runner - run with: djust <recipe>

default:
  @just --list

# Install extra development packages via Homebrew
install-extras:
    #!/bin/bash
    set -eufo pipefail

    if ! command -v brew &> /dev/null; then
        echo "Homebrew not found. Skipping package installation."
        echo "To install Homebrew, run:"
        echo "  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
        exit 1
    fi

    brew bundle --file=/dev/stdin <<'EOF'
    tap "derailed/k9s"
    tap "elohmeier/tap"
    tap "f1bonacc1/tap"
    tap "oven-sh/bun"
    brew "atuin"
    brew "bash-language-server"
    brew "derailed/k9s/k9s"
    brew "dprint"
    brew "elohmeier/tap/jsonnet-language-server"
    brew "elohmeier/tap/ssh-to-age"
    brew "entr"
    brew "f1bonacc1/tap/process-compose"
    brew "gh"
    brew "git"
    brew "git-delta"
    brew "git-lfs"
    brew "gnupg"
    brew "go"
    brew "go-jsonnet"
    brew "helm"
    brew "jsonnet-bundler"
    brew "lazygit"
    brew "lua-language-server"
    brew "make"
    brew "minio-mc"
    brew "neovim"
    brew "opentofu"
    brew "oven-sh/bun/bun"
    brew "pnpm"
    brew "ripgrep"
    brew "rsync"
    brew "rustup"
    brew "shellcheck"
    brew "shfmt"
    brew "stylua"
    brew "taplo"
    brew "tinymist"
    brew "typst"
    brew "typstyle"
    brew "watch"
    brew "yazi"
    brew "yq"
{{- if eq .chezmoi.os "darwin" }}
    brew "pinentry-mac"
    cask "db-browser-for-sqlite"
    cask "firefox"
    cask "ghostty"
    cask "google-chrome"
    cask "orbstack"
    cask "rectangle"
    cask "stats"
{{- end }}
    EOF

    echo "Extra packages installed successfully!"

# Generate age key from SSH key for sops/mise
setup-age-key ssh_key="~/.ssh/id_ed25519":
    #!/bin/bash
    set -eufo pipefail

    SSH_KEY="{{"{{"}} ssh_key {{"}}"}}"
    SSH_KEY="${SSH_KEY/#\~/$HOME}"
    AGE_KEY_DIR="$HOME/.config/sops/age"
    AGE_KEY_FILE="$AGE_KEY_DIR/keys.txt"

    if [ ! -f "$SSH_KEY" ]; then
        echo "SSH key not found: $SSH_KEY"
        exit 1
    fi

    if ! command -v ssh-to-age &> /dev/null; then
        echo "ssh-to-age not found. Run: djust install-extras"
        exit 1
    fi

    mkdir -p "$AGE_KEY_DIR"

    echo "Converting SSH key to age key..."
    echo "# generated from $SSH_KEY" > "$AGE_KEY_FILE"
    ssh-to-age -private-key -i "$SSH_KEY" >> "$AGE_KEY_FILE"

    echo "Age key written to: $AGE_KEY_FILE"
    echo ""
    echo "Public key (for .sops.yaml):"
    ssh-to-age -i "${SSH_KEY}.pub"
