{{- $theme := .theme | default "tokyonight_day" -}}
{{- if hasPrefix "tokyonight" $theme -}}
return {
  "folke/tokyonight.nvim",
  lazy = false,
  priority = 1000,
  opts = {
    style = "{{ trimPrefix "tokyonight_" $theme }}",
  },
  config = function(_, opts)
    require("tokyonight").setup(opts)
    vim.cmd([[colorscheme tokyonight]])
  end,
}
{{- else if hasPrefix "cyberdream" $theme -}}
return {
  "scottmckendry/cyberdream.nvim",
  lazy = false,
  priority = 1000,
  config = function()
    require("cyberdream").setup({
      transparent = true,
      italic_comments = true,
      hide_fillchars = true,
      borderless_telescope = true,
      terminal_colors = true,
    })
    vim.cmd([[colorscheme {{ if eq $theme "cyberdream_light" }}cyberdream-light{{ else }}cyberdream{{ end }}]])
  end,
}
{{- end }}
