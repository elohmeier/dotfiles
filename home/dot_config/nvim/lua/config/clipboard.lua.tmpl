{{- if .isWSL -}}
-- WSL clipboard configuration using wl-copy/wl-paste
local home = os.getenv("HOME")
vim.g.clipboard = {
  name = 'wsl-clipboard',
  copy = {
    ['+'] = home .. '/.local/bin/wl-copy',
  },
  paste = {
    ['+'] = home .. '/.local/bin/wl-paste',
  },
  cache_enabled = true,
}
{{- else -}}
-- Keep default clipboard behavior to avoid automatic copying on selection
vim.opt.clipboard = ''
{{- end -}}
