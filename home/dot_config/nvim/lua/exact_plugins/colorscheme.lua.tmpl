{{- $theme := includeTemplate "theme" . -}}
{{- if hasPrefix "tokyonight" $theme -}}
vim.pack.add({ 'https://github.com/folke/tokyonight.nvim' })
require('tokyonight').setup({ style = '{{ trimPrefix "tokyonight_" $theme }}' })
vim.cmd.colorscheme('tokyonight')
{{- else if hasPrefix "cyberdream" $theme -}}
vim.pack.add({ 'https://github.com/scottmckendry/cyberdream.nvim' })
require('cyberdream').setup({
  transparent = true,
  italic_comments = true,
  hide_fillchars = true,
  borderless_telescope = true,
  terminal_colors = true,
})
vim.cmd.colorscheme('{{ if eq $theme "cyberdream_light" }}cyberdream-light{{ else }}cyberdream{{ end }}')
{{- end }}
