[Unit]
Description=SSH TPM agent
Requires=ssh-tpm-agent.socket

[Service]
{{- with or (lookPath "ssh-askpass") (lookPath "/usr/libexec/gcr4-ssh-askpass") (lookPath "/usr/libexec/gcr-ssh-askpass") }}
Environment=SSH_ASKPASS={{ . }}
{{- end }}
ExecStart={{ includeTemplate "ssh-tpm-agent" . }}/ssh-tpm-agent
SuccessExitStatus=2
