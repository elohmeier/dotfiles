{{- with includeTemplate "age-plugin-agent" . -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.enno.age-plugin-se-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ . }}</string>
    <string>agent</string>
    <string>--lock-on-sleep</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>{{ $.chezmoi.homeDir }}/Library/Logs/age-plugin-se-agent.log</string>
  <key>StandardErrorPath</key>
  <string>{{ $.chezmoi.homeDir }}/Library/Logs/age-plugin-se-agent.log</string>
</dict>
</plist>
{{- end }}
