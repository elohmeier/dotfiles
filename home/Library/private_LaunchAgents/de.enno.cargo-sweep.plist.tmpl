{{- if lookPath "cargo-sweep" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.enno.cargo-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ lookPath "cargo-sweep" }}</string>
    <string>sweep</string>
    <string>--recursive</string>
    <string>--maxsize</string>
    <string>40GB</string>
    <string>{{ .chezmoi.homeDir }}/repos</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>12</integer>
  </dict>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/cargo-sweep.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/cargo-sweep.log</string>
</dict>
</plist>
{{- end }}
