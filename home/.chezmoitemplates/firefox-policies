{{- $mkcertInstalled := false -}}
{{- $mkcertCAFile := "" -}}
{{- with lookPath "mkcert" -}}
  {{- $mkcertCARoot := trim (output "mkcert" "-CAROOT") -}}
  {{- if $mkcertCARoot -}}
    {{- $candidate := joinPath $mkcertCARoot "rootCA.pem" -}}
    {{- if (stat $candidate) -}}
      {{- $mkcertInstalled = true -}}
      {{- $mkcertCAFile = $candidate -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{
  "policies": {
    "Bookmarks": [
      {
        "Placement": "toolbar",
        "Title": "Grafana",
        "URL": "https://grafana.pug-coho.ts.net/"
      }
    ],
    "Certificates": {
      "ImportEnterpriseRoots": true{{ if $mkcertInstalled }},
      "Install": [
        "{{ $mkcertCAFile }}"
      ]{{ end }}
    },
    "Cookies": {
      "Behavior": "reject-foreign",
      "BehaviorPrivateBrowsing": "reject-foreign"
    },
    "DisableFeedbackCommands": true,
    "DisableFirefoxAccounts": true,
    "DisableFirefoxScreenshots": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableProfileImport": true,
    "DisableSystemAddonUpdate": true,
    "DisableTelemetry": true,
    "DisplayBookmarksToolbar": "always",
    "EnableTrackingProtection": {
      "Cryptomining": true,
      "EmailTracking": true,
      "Fingerprinting": true,
      "Value": true
    },
    "ExtensionSettings": {
      "uBlock0@raymondhill.net": {
        "default_area": "navbar",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "installation_mode": "normal_installed",
        "private_browsing": true,
        "updates_disabled": false
      }
    },
    "FirefoxHome": {
      "Highlights": false,
      "Pocket": false,
      "Search": true,
      "SponsoredPocket": false,
      "SponsoredTopSites": false,
      "TopSites": false
    },
    "NoDefaultBookmarks": true,
    "OverrideFirstRunPage": "",
    "Preferences": {
      "extensions.getAddons.showPane": {
        "Status": "locked",
        "Type": "boolean",
        "Value": false
      },
      "security.ssl.errorReporting.enabled": {
        "Status": "locked",
        "Type": "boolean",
        "Value": false
      },
      "security.enterprise_roots.enabled": {
        "Status": "locked",
        "Type": "boolean",
        "Value": true
      }
    },
    "TranslateEnabled": false
  }
}
