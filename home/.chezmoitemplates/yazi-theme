{{- $t := index .yazi .theme -}}
[manager]
cwd = { fg = "{{ $t.cwd }}", italic = true }
hovered         = { bg = "{{ $t.hovered_bg }}" }
preview_hovered = { bg = "{{ $t.hovered_bg }}" }
find_keyword  = { fg = "{{ $t.find_keyword_fg }}", bg = "{{ $t.find_keyword_bg }}", bold = true }
find_position = { fg = "{{ $t.find_position_fg }}", bg = "{{ $t.find_position_bg }}", bold = true }
marker_copied   = { fg = "{{ $t.marker_copied }}", bg = "{{ $t.marker_copied }}" }
marker_cut      = { fg = "{{ $t.marker_cut }}", bg = "{{ $t.marker_cut }}" }
marker_marked   = { fg = "{{ $t.marker_marked }}", bg = "{{ $t.marker_marked }}" }
marker_selected = { fg = "{{ $t.marker_selected }}", bg = "{{ $t.marker_selected }}" }
tab_active   = { fg = "{{ $t.tab_active_fg }}", bg = "{{ $t.tab_active_bg }}" }
tab_inactive = { fg = "{{ $t.tab_inactive_fg }}", bg = "{{ $t.tab_inactive_bg }}" }
tab_width    = 1
count_copied   = { fg = "{{ $t.count_copied_fg }}", bg = "{{ $t.count_copied_bg }}" }
count_cut      = { fg = "{{ $t.count_cut_fg }}", bg = "{{ $t.count_cut_bg }}" }
count_selected = { fg = "{{ $t.count_selected_fg }}", bg = "{{ $t.count_selected_bg }}" }
border_symbol = "│"
border_style  = { fg = "{{ $t.border }}" }

[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "{{ $t.separator_fg }}", bg = "{{ $t.separator_fg }}" }
mode_normal = { fg = "{{ $t.mode_normal_fg }}", bg = "{{ $t.mode_normal_bg }}", bold = true }
mode_select = { fg = "{{ $t.mode_select_fg }}", bg = "{{ $t.mode_select_bg }}", bold = true }
mode_unset  = { fg = "{{ $t.mode_unset_fg }}", bg = "{{ $t.mode_unset_bg }}", bold = true }
progress_label  = { fg = "{{ $t.progress_label }}", bold = true }
progress_normal = { fg = "{{ $t.progress_normal }}" }
progress_error  = { fg = "{{ $t.progress_error }}" }
permissions_t = { fg = "{{ $t.perm_type }}" }
permissions_r = { fg = "{{ $t.perm_read }}" }
permissions_w = { fg = "{{ $t.perm_write }}" }
permissions_x = { fg = "{{ $t.perm_exec }}" }
permissions_s = { fg = "{{ $t.perm_sep }}" }

[select]
border   = { fg = "{{ $t.select_border }}" }
active   = { fg = "{{ $t.select_active_fg }}",  bg = "{{ $t.select_active_bg }}" }
inactive = { fg = "{{ $t.select_inactive }}" }

[input]
border   = { fg = "{{ $t.input_border }}" }
title    = {}
value    = { fg = "{{ $t.input_value }}" }
selected = { bg = "{{ $t.input_selected }}" }

[completion]
border   = { fg = "{{ $t.input_border }}" }
active   = { fg = "{{ $t.select_active_fg }}", bg = "{{ $t.select_active_bg }}" }
inactive = { fg = "{{ $t.select_active_fg }}" }

[tasks]
border  = { fg = "{{ $t.tasks_border }}" }
title   = {}
hovered = { fg = "{{ $t.tasks_hovered_fg }}", bg="{{ $t.tasks_hovered_bg }}" }

[which]
cols = 3
mask            = { bg = "{{ $t.which_mask }}" }
cand            = { fg = "{{ $t.which_cand }}" }
rest            = { fg = "{{ $t.which_rest }}" }
desc            = { fg = "{{ $t.which_desc }}" }
separator       = "  "
separator_style = { fg = "{{ $t.which_separator }}" }

[notify]
title_info  = { fg = "{{ $t.notify_info }}" }
title_warn  = { fg = "{{ $t.notify_warn }}" }
title_error = { fg = "{{ $t.notify_error }}" }

[help]
on      = { fg = "{{ $t.help_on }}" }
run     = { fg = "{{ $t.help_run }}" }
hovered = { bg = "{{ $t.help_hovered }}" }
footer  = { fg = "{{ $t.help_footer_fg }}", bg = "{{ $t.help_footer_bg }}" }

[filetype]
rules = [
	{ mime = "image/*", fg = "{{ $t.file_image }}" },
	{ mime = "{audio,video}/*", fg = "{{ $t.file_media }}" },
	{ mime = "application/*zip", fg = "{{ $t.file_archive }}" },
	{ mime = "application/x-{tar,bzip*,7z-compressed,xz,rar}", fg = "{{ $t.file_archive }}" },
	{ mime = "application/{pdf,doc,rtf,vnd.*}", fg = "{{ $t.file_doc }}" },
	{ name = "*", is = "orphan", bg = "{{ $t.file_archive }}" },
	{ name = "*", is = "exec"  , fg = "{{ $t.file_exec }}" },
	{ name = "*/", fg = "{{ $t.file_dir }}" }
]