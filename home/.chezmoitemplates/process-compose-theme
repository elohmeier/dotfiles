{{- $t := index .process_compose .theme -}}
style:
  name: {{ .theme }}
  body:
    fgColor: "{{ $t.fg }}"
    bgColor: "{{ $t.bg }}"
    secondaryTextColor: "{{ $t.secondary }}"
    tertiaryTextColor: "{{ $t.tertiary }}"
    borderColor: "{{ $t.border }}"
  stat_table:
    keyFgColor: "{{ $t.stat_key }}"
    valueFgColor: "{{ $t.stat_value }}"
    logoColor: "{{ $t.stat_logo }}"
  proc_table:
    fgColor: "{{ $t.proc_fg }}"
    fgWarning: "{{ $t.proc_warning }}"
    fgPending: "{{ $t.proc_pending }}"
    fgCompleted: "{{ $t.proc_completed }}"
    fgError: "{{ $t.proc_error }}"
    headerFgColor: "{{ $t.proc_header }}"
  help:
    fgColor: "{{ $t.help_fg }}"
    keyColor: "{{ $t.help_key }}"
    hlColor: "{{ $t.help_hl }}"
    categoryFgColor: "{{ $t.help_category }}"
  dialog:
    fgColor: "{{ $t.dialog_fg }}"
    bgColor: "{{ $t.dialog_bg }}"
    contrastBgColor: "{{ $t.dialog_contrast }}"
    attentionBgColor: "{{ $t.dialog_attention }}"
    buttonFgColor: "{{ $t.button_fg }}"
    buttonBgColor: "{{ $t.button_bg }}"
    buttonFocusFgColor: "{{ $t.button_focus_fg }}"
    buttonFocusBgColor: "{{ $t.button_focus_bg }}"
    labelFgColor: "{{ $t.label_fg }}"
    fieldFgColor: "{{ $t.field_fg }}"
    fieldBgColor: "{{ $t.field_bg }}"