{{- $t := index .tmux .theme -}}
# {{ $t.name }}
set -g mode-style "fg={{ $t.mode_fg }},bg={{ $t.mode_bg }}"
set -g message-style "fg={{ $t.mode_fg }},bg={{ $t.mode_bg }}"
set -g message-command-style "fg={{ $t.mode_fg }},bg={{ $t.mode_bg }}"
set -g pane-border-style "fg={{ $t.pane_border }}"
set -g pane-active-border-style "fg={{ $t.pane_active }}"
set -g status "on"
set -g status-justify "left"
set -g status-style "fg={{ $t.status_fg }},bg={{ $t.status_bg }}"
set -g status-left-length "100"
set -g status-right-length "100"
set -g status-left-style NONE
set -g status-right-style NONE
set -g status-left "#[fg={{ $t.status_left_fg }},bg={{ $t.status_left_bg }},bold] #S #[fg={{ $t.status_left_bg }},bg={{ $t.status_bg }},nobold,nounderscore,noitalics]"
set -g status-right "#[fg={{ $t.mode_bg }},bg={{ $t.status_bg }},nobold,nounderscore,noitalics]#[fg={{ $t.mode_fg }},bg={{ $t.mode_bg }}] %Y-%m-%d  %H:%M #[fg={{ $t.mode_fg }},bg={{ $t.mode_bg }},nobold,nounderscore,noitalics]#[fg={{ $t.status_left_fg }},bg={{ $t.status_left_bg }},bold] #h "
setw -g window-status-activity-style "underscore,fg={{ $t.window_activity_fg }},bg={{ $t.status_bg }}"
setw -g window-status-separator ""
setw -g window-status-style "NONE,fg={{ $t.window_fg }},bg={{ $t.status_bg }}"
setw -g window-status-format "#[fg={{ $t.status_bg }},bg={{ $t.status_bg }},nobold,nounderscore,noitalics]#[default] #I  #W #F #[fg={{ $t.status_bg }},bg={{ $t.status_bg }},nobold,nounderscore,noitalics]"
setw -g window-status-current-format "#[fg={{ $t.status_bg }},bg={{ $t.mode_bg }},nobold,nounderscore,noitalics]#[fg={{ $t.mode_fg }},bg={{ $t.mode_bg }},bold] #I  #W #F #[fg={{ $t.mode_bg }},bg={{ $t.status_bg }},nobold,nounderscore,noitalics]"
