{{- $t := index .lazygit .theme -}}
activeBorderColor:
  - "{{ $t.activeBorder }}"
{{- if hasKey $t "bold" }}
  - bold
{{- end }}
inactiveBorderColor:
  - "{{ $t.inactiveBorder }}"
searchingActiveBorderColor:
  - "{{ $t.searchingActiveBorder }}"
{{- if hasKey $t "bold" }}
  - bold
{{- end }}
optionsTextColor:
  - "{{ $t.options }}"
selectedLineBgColor:
  - "{{ $t.selectedLineBg }}"
cherryPickedCommitFgColor:
  - "{{ $t.cherryPickedFg }}"
cherryPickedCommitBgColor:
  - "{{ $t.cherryPickedBg }}"
{{- if hasKey $t "markedBaseFg" }}
markedBaseCommitFgColor:
  - "{{ $t.markedBaseFg }}"
markedBaseCommitBgColor:
  - "{{ $t.markedBaseBg }}"
{{- end }}
unstagedChangesColor:
  - "{{ $t.unstagedChanges }}"
defaultFgColor:
  - "{{ $t.defaultFg }}"