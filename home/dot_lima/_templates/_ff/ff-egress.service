[Unit]
Description=Freifunk egress via %i
Wants=network-online.target
After=network-online.target

[Service]
Environment=FF_PROFILE=%i FF_INGRESS_TCP_PORTS=22
ExecStartPre=/usr/local/sbin/ff-egress-down
ExecStartPre=/bin/sh -c 'ip -j -4 route show default | jq -r ".[0].dev // empty" >/run/ff-egress-uplink'
ExecStart=/usr/local/bin/entrypoint.sh
ExecStartPost=/bin/sh -c 'until [ -e /run/ff-egress-ready ]; do kill -0 "$MAINPID" || exit 1; sleep 1; done; install -m 644 /state/%i/resolv.conf /etc/resolv.conf'
ExecStopPost=/usr/local/sbin/ff-egress-down
# The fastd and tunneldigger entrypoints exit 143 on SIGTERM; a stop is still clean.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
