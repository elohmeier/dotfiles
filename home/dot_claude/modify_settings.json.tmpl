#!/bin/bash
desired='{"$schema":"https://json.schemastore.org/claude-code-settings.json","env":{"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC":"1","CLAUDE_CODE_ENABLE_TELEMETRY":"0","DISABLE_TELEMETRY":"1"},"includeCoAuthoredBy":false}'
current="$(cat)"
if [ -z "$current" ]; then
  echo "$desired"
else
  echo "$current" | jq "del(.hooks.Stop) | . * $desired | if (.hooks // {}) == {} then del(.hooks) else . end"
fi
