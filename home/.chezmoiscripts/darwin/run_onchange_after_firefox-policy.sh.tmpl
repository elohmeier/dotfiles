#!/bin/sh
# Install Firefox policy file on macOS
# hash: {{ include ".chezmoitemplates/firefox-policies" | sha256sum }}

POLICIES='{{ template "firefox-policies" . }}'
FOUND=

install_policy() {
    APP=$1
    DEST="$APP/Contents/Resources/distribution"
    FOUND=1

    mkdir -p "$DEST" 2>/dev/null && printf '%s\n' "$POLICIES" > "$DEST/policies.json" 2>/dev/null
}

[ -d "$HOME/Applications/Firefox.app" ] && {
    if install_policy "$HOME/Applications/Firefox.app"; then
        exit 0
    fi
    echo "warning: cannot write Firefox policy to $HOME/Applications/Firefox.app" >&2
}

[ -d "/Applications/Firefox.app" ] && {
    FOUND=1
    echo "warning: skipping /Applications/Firefox.app because it requires admin permissions" >&2
}

[ "$FOUND" ] && {
    echo "warning: Firefox policy was not installed" >&2
}
