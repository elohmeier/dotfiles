{{ if lookPath "uv" -}}
#!/bin/sh
# package sources:
{{ range glob (joinPath .chezmoi.sourceDir "../scripts/**/*.py") -}}
# {{ base . }}: {{ include . | sha256sum }}
{{ end -}}
{{ $ui := joinPath .chezmoi.sourceDir "../tools/agent-session-ui" -}}
{{ $sources := "" }}{{ range glob (joinPath $ui "{package.json,pnpm-lock.yaml,vite.config.ts,src/**/*.{svelte,ts,css,html}}") }}{{ $sources = print $sources (include .) }}{{ end -}}
# agent-session-ui: {{ $sources | sha256sum }}
# metadata: {{ include "../pyproject.toml" | sha256sum }} {{ include "../uv.lock" | sha256sum }}

set -e
{{ if lookPath "pnpm" -}}
"{{ lookPath "pnpm" }}" --dir "{{ $ui }}" install --frozen-lockfile --silent
"{{ lookPath "pnpm" }}" --dir "{{ $ui }}" build >/dev/null
{{ end -}}
uv="{{ lookPath "uv" }}"
requirements="$("{{ lookPath "mktemp" }}")"
"$uv" export --project "{{ .chezmoi.sourceDir }}/.." --frozen --no-dev --no-emit-project --output-file "$requirements" >/dev/null
"$uv" tool install --force --python {{ include "../.python-version" | trim }} --constraints "$requirements" "{{ .chezmoi.sourceDir }}/.."
"{{ lookPath "rm" }}" "$requirements"
{{ end -}}
