{{/* vim: set filetype=gotmpl: */}}#!/bin/bash

set -eufo pipefail

# other useful packages:
{{ $extraBrews := list
    "aerc"
    "atuin"
    "dante"
    "chawan"
    "elohmeier/tap/tabula-java"
    "mailpit"
    "maven"
    "minio"
    "nim"
    "ollama"
    "pass"
    "pkgconf"
    "postgresql@17"
    "rustup"
    "tabiew"
    "tanka"
    "valkey"
    "w3m" -}}
{{ $extraCasks := list
    "cleanshot"
    "dbeaver-enterprise"
    "element"
    "logseq"
    "rectangle"
    "spotify"
    "visual-studio-code" -}}

{{ $brews := list
    "atuin"
    "bash-language-server"
    "bat"
    "btop"
    "oven-sh/bun/bun"
    "derailed/k9s/k9s"
    "direnv"
    "dprint"
    "elohmeier/tap/jsonnet-language-server"
    "entr"
    "eza"
    "f1bonacc1/tap/process-compose"
    "fd"
    "fish"
    "fzf"
    "gh"
    "git-delta"
    "go"
    "go-jsonnet"
    "helm"
    "jsonnet-bundler"
    "lazygit"
    "lua-language-server"
    "make"
    "minio-mc"
    "ncdu"
    "neovim"
    "opentofu"
    "pnpm"
    "ripgrep"
    "rsync"
    "shellcheck"
    "shfmt"
    "sops"
    "stylua"
    "tinymist"
    "typst"
    "typstyle"
    "uv"
    "vivid"
    "watch"
    "yazi"
    "yq"
    "zoxide" -}}
{{ $casks := list
    "db-browser-for-sqlite"
    "firefox"
    "font-ibm-plex-mono"
    "font-ibm-plex-sans"
    "font-spleen"
    "ghostty"
    "google-chrome"
    "orbstack"
    "rectangle"
    "stats" -}}

# Extract taps from brew formulas
{{ $taps := list -}}
{{ range ($brews | sortAlpha | uniq) -}}
{{   if contains "/" . -}}
{{     $parts := splitList "/" . -}}
{{     if eq (len $parts) 3 -}}
{{       $tap := printf "%s/%s" (index $parts 0) (index $parts 1) -}}
{{       $taps = append $taps $tap -}}
{{     end -}}
{{   end -}}
{{ end -}}

brew bundle --file=/dev/stdin <<EOF
{{ range ($taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end -}}
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
