{{- $brew := lookPath "brew" -}}
{{- $apk := lookPath "apk" -}}
#!/bin/sh
{{ if $brew -}}
set -u

echo "Installing packages..."

"{{ $brew }}" bundle --file=/dev/stdin <<EOF
brew "bat"
brew "btop"
brew "eza"
brew "fd"
{{- if not (lookPath "fish") }}
brew "fish"
{{- end }}
brew "fzf"
brew "just"
brew "ncdu"
brew "sops"
brew "uv"
brew "vivid"
brew "zoxide"
EOF
{{ else if $apk -}}
set -u

echo "Installing packages..."

"{{ $apk }}" add bat btop curl eza fd fish fzf git just ncdu python3 ripgrep sops uv vivid zoxide
{{ else -}}
exit 0
{{ end -}}
