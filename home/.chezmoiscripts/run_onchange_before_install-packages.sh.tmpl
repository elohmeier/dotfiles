{{- with lookPath "apk" -}}
#!/bin/sh
set -eu

set --
for package in bat btop curl eza fd fish fzf git just ncdu ncurses python3 ripgrep sops uv vivid zoxide; do
	tool=$package
	case "$package" in
	ncurses) tool=tic ;;
	ripgrep) tool=rg ;;
	esac
	command -v "$tool" >/dev/null 2>&1 || set -- "$@" "$package"
done
[ "$#" -eq 0 ] || "{{ . }}" add "$@"
{{ end -}}
