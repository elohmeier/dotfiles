{{/* vim: set filetype=gotmpl: */}}#!/bin/bash

set -eufo pipefail

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo "Homebrew not found. Skipping package installation."
    echo "To install Homebrew, run:"
    echo "  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    exit 0
fi

# Other useful packages (not installed by default):
# Brews:
#   aerc, dante, chawan, elohmeier/tap/tabula-java, mailpit, maven,
#   minio, nim, ollama, pass, pkgconf, postgresql@17, rustup, tabiew,
#   tanka, valkey, w3m
# Casks:
#   cleanshot, dbeaver-enterprise, element, logseq, rectangle, spotify,
#   visual-studio-code

# Package mode from chezmoi config
MINIMAL_PACKAGES="{{ .minimalPackages }}"

# Essential packages (always installed)
ESSENTIAL_BREWS=(
    bat
    btop
    eza
    fd
    fish
    fzf
    ncdu
    sops
    uv
    zoxide
)

ESSENTIAL_CASKS=(
{{- if eq .chezmoi.os "darwin" }}
    firefox
    font-ibm-plex-mono
    font-ibm-plex-sans
    font-spleen
    ghostty
    google-chrome
{{- end }}
)

# Additional packages for full installation
EXTRA_BREWS=(
    atuin
    bash-language-server
    oven-sh/bun/bun
    derailed/k9s/k9s
    direnv
    dprint
    elohmeier/tap/jsonnet-language-server
    entr
    f1bonacc1/tap/process-compose
    gh
    git-delta
    go
    go-jsonnet
    gnupg
    helm
    jsonnet-bundler
    lazygit
    lua-language-server
    make
    minio-mc
    neovim
    opentofu
    pinentry-mac
    pnpm
    ripgrep
    rsync
    shellcheck
    shfmt
    stylua
    tinymist
    typst
    typstyle
    vivid
    watch
    yazi
    yq
)

EXTRA_CASKS=(
{{- if eq .chezmoi.os "darwin" }}
    db-browser-for-sqlite
    orbstack
    rectangle
    stats
{{- end }}
)

# Build final package lists
BREWS=("${ESSENTIAL_BREWS[@]}")
CASKS=("${ESSENTIAL_CASKS[@]}")

if [ "$MINIMAL_PACKAGES" = "true" ]; then
    echo "Installing minimal package set..."
else
    echo "Installing full package set..."
    BREWS+=("${EXTRA_BREWS[@]}")
    CASKS+=("${EXTRA_CASKS[@]}")
fi

# Extract and add taps
TAPS=()
for brew in "${BREWS[@]}"; do
    if [[ "$brew" == *"/"* ]]; then
        # Extract tap from formula like "owner/tap/formula"
        IFS='/' read -r owner tap formula <<< "$brew"
        if [ -n "$owner" ] && [ -n "$tap" ] && [ -n "$formula" ]; then
            TAP="$owner/$tap"
            # Add tap if not already in array
            if [[ ! " ${TAPS[@]:-} " =~ " ${TAP} " ]]; then
                TAPS+=("$TAP")
            fi
        fi
    fi
done

# Generate and run brew bundle
{
    # Add taps
    if [ ${#TAPS[@]} -gt 0 ]; then
        for tap in "${TAPS[@]}"; do
            echo "tap \"$tap\""
        done
    fi

    # Add brews
    for brew in "${BREWS[@]}"; do
        echo "brew \"$brew\""
    done

    # Add casks (only on macOS)
{{- if eq .chezmoi.os "darwin" }}
    for cask in "${CASKS[@]}"; do
        echo "cask \"$cask\""
    done
{{- end }}
} | brew bundle --file=/dev/stdin
