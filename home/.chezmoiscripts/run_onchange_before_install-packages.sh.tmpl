{{/* vim: set filetype=gotmpl: */}}#!/bin/bash

set -uo pipefail

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo "Homebrew not found. Skipping package installation."
    exit 0
fi

# Essential packages only - for extra dev tools run: djust install-extras
#
# Other useful packages (not installed by default):
# Brews:
#   aerc, dante, chawan, elohmeier/tap/tabula-java, mailpit, maven,
#   minio, nim, ollama, pass, pkgconf, postgresql@17, rustup, tabiew,
#   tanka, valkey, w3m
# Casks:
#   cleanshot, dbeaver-enterprise, element, logseq, spotify,
#   visual-studio-code

# Essential packages (always installed)
ESSENTIAL_BREWS=(
    bat
    btop
    eza
    fd
    fish
    fzf
    just
    ncdu
    sops
    uv
    vivid
    zoxide
)

ESSENTIAL_CASKS=(
{{- if eq .chezmoi.os "darwin" }}
    font-ibm-plex-mono
    font-ibm-plex-sans
    font-spleen
{{- end }}
)

echo "Installing essential packages..."

# Generate and run brew bundle
{
    for brew in "${ESSENTIAL_BREWS[@]}"; do
        echo "brew \"$brew\""
    done

{{- if eq .chezmoi.os "darwin" }}
    for cask in "${ESSENTIAL_CASKS[@]}"; do
        echo "cask \"$cask\""
    done
{{- end }}
} | brew bundle --file=/dev/stdin || true

{{- if .isWSL }}
# Install xdg-utils for WSL using apt
if command -v apt-get &>/dev/null; then
    sudo apt-get update
    sudo apt-get install -y desktop-file-utils xdg-utils
else
    echo "apt-get not found. Skipping xdg-utils installation."
    exit 0
fi
{{- end }}
