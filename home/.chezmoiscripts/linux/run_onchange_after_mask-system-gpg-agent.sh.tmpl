{{- if and (hasPrefix "/home/linuxbrew/" (lookPath "gpg")) (lookPath "systemctl") (stat "/usr/bin/gpg-agent") -}}
#!/bin/sh
# Brew gnupg shadows apt's: stop systemd from socket-activating the older /usr/bin/gpg-agent
systemctl --user mask --now gpg-agent.socket gpg-agent-ssh.socket gpg-agent-extra.socket gpg-agent-browser.socket
gpgconf --kill gpg-agent
{{ end -}}
