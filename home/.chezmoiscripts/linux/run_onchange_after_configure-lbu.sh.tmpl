{{- $lbu := lookPath "lbu" -}}
{{- if and (lookPath "apk") $lbu -}}
#!/bin/sh

"{{ $lbu }}" exclude \
    "{{ .chezmoi.homeDir }}/.cache" \
    "{{ .chezmoi.homeDir }}/.codex" \
    "{{ .chezmoi.homeDir }}/.local/share/uv" \
    "{{ .chezmoi.homeDir }}/.platformio" \
    "{{ .chezmoi.homeDir }}/.ssh/agent"
"{{ $lbu }}" include \
    "{{ .chezmoi.homeDir }}/.codex/auth.json" \
    "{{ .chezmoi.homeDir }}/.codex/config.toml" \
    "{{ .chezmoi.homeDir }}/.codex/themes"

mkdir -p /etc/lbu/pre-package.d
cat >/etc/lbu/pre-package.d/exclude-pio <<'EOF'
#!/bin/sh
find {{ .chezmoi.homeDir | quote }} -type d -name .pio -prune -exec {{ $lbu | quote }} exclude {} +
EOF
chmod +x /etc/lbu/pre-package.d/exclude-pio
{{- end }}
