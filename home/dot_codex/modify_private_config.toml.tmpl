{{- $freecadCmd := joinPath .chezmoi.homeDir "Applications/FreeCAD.app/Contents/Resources/bin/freecadcmd" -}}
{{- if not (stat $freecadCmd) -}}
{{- $freecadCmd = "/Applications/FreeCAD.app/Contents/Resources/bin/freecadcmd" -}}
{{- end -}}
#!/usr/bin/env python3
import json
import sys
import tomllib

desired = """\
personality = "pragmatic"
sandbox_mode = "workspace-write"
allow_login_shell = false

[tui]
theme = "{{ template "theme" . }}"

[sandbox_workspace_write]
writable_roots = ["{{ .chezmoi.homeDir }}/.cache"]

[projects."{{ .chezmoi.homeDir }}/repos"]
trust_level = "trusted"
{{ if and (eq .chezmoi.os "darwin") (lookPath "uvx") (stat $freecadCmd) }}
[mcp_servers.freecad]
command = {{ lookPath "uvx" | toJson }}
args = ["freecad-mcp@0.1.28", "--host", "127.0.0.1", "--freecadcmd", {{ $freecadCmd | toJson }}]
{{ end }}
"""

current = sys.stdin.buffer.read()
current_d = tomllib.loads(current.decode()) if current.strip() else {}
desired_d = tomllib.loads(desired)
managed = ["notify"]


def contains(base, required):
    return all(
        k in base and (contains(base[k], v) if isinstance(v, dict) else base[k] == v)
        for k, v in required.items()
    )


if contains(current_d, desired_d) and all(
    (k in desired_d) == (k in current_d) for k in managed
):
    sys.stdout.buffer.write(current)
    sys.exit(0)

for k in managed:
    current_d.pop(k, None)


def deep_merge(base, override):
    for k, v in override.items():
        if k in base and isinstance(base[k], dict) and isinstance(v, dict):
            deep_merge(base[k], v)
        else:
            base[k] = v


deep_merge(current_d, desired_d)


def value(v):
    if isinstance(v, bool):
        return str(v).lower()
    if isinstance(v, int | float):
        return str(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ", ".join(value(x) for x in v) + "]"
    raise TypeError(type(v))


def dump(d, prefix=()):
    for k, v in d.items():
        if not isinstance(v, dict):
            print(f"{value(k)} = {value(v)}")
    for k, v in d.items():
        if isinstance(v, dict):
            print(f"\n[{'.'.join(value(p) for p in (*prefix, k))}]")
            dump(v, (*prefix, k))


dump(current_d)
