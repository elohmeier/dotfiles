# Set default shell to fish
{{ if eq .chezmoi.os "darwin" -}}
set-option -g default-shell /opt/homebrew/bin/fish
{{- else if eq .chezmoi.os "linux" -}}
set-option -g default-shell /home/linuxbrew/.linuxbrew/bin/fish
{{- end }}

# Split panes using Vim-like bindings (with current directory)
# Match Neovim behavior: s for horizontal split, v for vertical split
bind-key s split-window -v -c "#{pane_current_path}"
bind-key v split-window -h -c "#{pane_current_path}"

# Vim-like pane navigation
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

# More ergonomic Alt+hjkl pane navigation
bind-key -n M-h select-pane -L
bind-key -n M-j select-pane -D
bind-key -n M-k select-pane -U
bind-key -n M-l select-pane -R

# Window navigation (using prefix + n/p instead of Ctrl+h/l to avoid Neovim conflicts)
bind-key n next-window
bind-key p previous-window

# Create new window with current directory
bind-key c new-window -c "#{pane_current_path}"

# Vim-like pane resizing
bind-key -n M-Left resize-pane -L 5
bind-key -n M-Down resize-pane -D 5
bind-key -n M-Up resize-pane -U 5
bind-key -n M-Right resize-pane -R 5

# Vim-like copy mode
set-window-option -g mode-keys vi
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi V send -X select-line
{{- if .isWSL }}
# WSL clipboard integration
bind-key -T copy-mode-vi y send -X copy-pipe-and-cancel "$HOME/.local/bin/wl-copy"
bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel "$HOME/.local/bin/wl-copy"
{{- else }}
bind-key -T copy-mode-vi y send -X copy-selection-and-cancel
{{- end }}

# Enable mouse support
set -g mouse on

# Enable true color support
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"

# Set terminal title
set -g set-titles on
set -g set-titles-string "#S / #W"

# Increase scrollback buffer size
set -g history-limit 50000

# Activity monitoring
setw -g monitor-activity on
set -g visual-activity on
