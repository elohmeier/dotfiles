#!/bin/sh
set -e

case "$1" in
    on)
        [ "$(stat -f -c %T /)" = tmpfs ]
        modprobe zram
        if ! grep -q /dev/zram0 /proc/swaps; then
            echo zstd >/sys/block/zram0/comp_algorithm
            echo 4G >/sys/block/zram0/disksize
            mkswap /dev/zram0
            swapon -p 100 /dev/zram0
        fi
        if [ -e /dev/disk/by-label/ALPINE_SWAP ]; then
            sd_swap=$(readlink -f /dev/disk/by-label/ALPINE_SWAP)
            grep -q "$sd_swap" /proc/swaps || swapon -p 10 "$sd_swap"
        fi
        sysctl -w vm.swappiness=150 vm.page-cluster=0
        mount -o remount,size=7G /
        ;;
    off)
        if [ -e /dev/disk/by-label/ALPINE_SWAP ]; then
            sd_swap=$(readlink -f /dev/disk/by-label/ALPINE_SWAP)
            grep -q "$sd_swap" /proc/swaps && swapoff "$sd_swap"
        fi
        grep -q /dev/zram0 /proc/swaps && swapoff /dev/zram0
        [ ! -e /sys/block/zram0/reset ] || echo 1 >/sys/block/zram0/reset
        modprobe -r zram 2>/dev/null || true
        sysctl -w vm.swappiness=60 vm.page-cluster=3
        ;;
    status)
        df -h /
        cat /proc/swaps
        ;;
    *)
        echo "usage: diskless-swap on|off|status" >&2
        exit 1
        ;;
esac
