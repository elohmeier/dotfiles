#!/usr/bin/env ruby
#
# Usage: h <term>
#
# term can be of form [\w-]+ for search
# <user>/<repo> for github repos
# url for cloning

require 'find'
require 'json'
require 'open-uri'
require 'pathname'
require 'uri'

CODE_ROOT = Pathname.new('{{ .chezmoi.homeDir }}/repos')

def abort(*)
  puts Dir.pwd
  super
end

term = ARGV.shift
path = nil
url  = nil

# git config: h.rewrite = "<regex> <replacement>", h.svn = <svn URL prefix>
IO.popen(%w[git config --get-all h.rewrite], &:readlines).each do |l|
  re, sub = l.chomp.split(' ', 2)
  term = term.sub(Regexp.new(re), sub)
end if term
svn = IO.popen(%w[git config --get-all h.svn], &:read).split.find { |p| term&.start_with?(p) }

case term
when nil, "-h", "--help"
  abort "Usage: h (<name> | <repo>/<name> | <url>) [git opts]"
when %r[\A([\w\.\-]+)/([\w\.\-]+)\z] # github user/repo
  begin
    api_info = JSON.load(URI.open("https://api.github.com/repos/#{$1}/#{$2}").read)
    owner = api_info["owner"]["login"]
    repo = api_info["name"]
  rescue OpenURI::HTTPError
    owner = $1
    repo = $2
  end

  url  = "git@github.com:#{owner}/#{repo}.git"
  path = CODE_ROOT.join('github.com', owner, repo)
when ->(_) { svn } # svn URL, fetched via git url.<base>.insteadOf
  fetch = IO.popen(['git', 'ls-remote', '--get-url', term], &:read).chomp
  url   = IO.popen(['svn', 'info', '--non-interactive', '--show-item', 'repos-root-url', fetch], &:read).chomp
  abort "#{term} not found" if url.empty?
  svn  = URI.parse(term[0, term.size - fetch.size + url.size])
  path = CODE_ROOT.join(svn.host, svn.path[1..])
when %r[://] # URL
  url  = URI.parse(term)
  path = CODE_ROOT.join(url.host.downcase, url.path[1..-1])
  abort "Missing url scheme" unless url.scheme
when %r[\Agit(?:ea)?@([^:]+):(.*)] # git url
  url  = term
  path = CODE_ROOT.join($1, $2)
when %r[\A[\w\.\-]+\z] # just search for repo
  path_depth = 0

  if term == term.downcase
    compare = ->(basename) { basename.downcase == term }
  else
    compare = ->(basename) { basename == term }
  end

  CODE_ROOT.find do |curpath|
    next unless curpath.directory?

    depth = curpath.to_s.sub(CODE_ROOT.to_s, '').split('/').size

    if compare.(curpath.basename.to_s) && depth > path_depth
      path = curpath
      path_depth = depth
    end

    Find.prune if depth > 3
  end
else
  abort "Unknown pattern for #{term}"
end

abort "#{term} not found" unless path

path = path.sub_ext('') if path.extname == '.git'

unless path.directory?
  parent = path.parent
  dir = parent
  dir = dir.parent until dir.directory? || dir.root?
  parent.mkpath
  clone = svn ? ['svn', 'clone', "--rewrite-root=#{svn}", *(ARGV.any? ? ARGV : ['-r', 'HEAD'])] : ['clone', *(ARGV.any? ? ARGV : ['--recursive'])]
  unless system(
      'git',
      *clone,
      '--',
      url.to_s,
      path.to_s,
      out: :err,
      close_others: true,
  )
    until parent == dir
      parent.rmdir
      parent = parent.parent
    end

    exit $?.exitstatus
  end
end

puts path
