#!/usr/bin/env bash

# Enable error logging if DEBUG is set
if [ -n "$WSL_CLIPBOARD_DEBUG" ]; then
    exec 2>>"$HOME/.local/share/wl-copy.log"
    set -x
    echo "[$(date)] wl-copy called with args: $*" >&2
fi

# Check if PowerShell exists
POWERSHELL="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
if [ ! -x "$POWERSHELL" ]; then
    echo "Error: PowerShell not found at $POWERSHELL" >&2
    exit 1
fi

# Create temporary file for large inputs
TEMP_FILE=$(mktemp /tmp/wl-copy.XXXXXX)
trap 'rm -f "$TEMP_FILE"' EXIT

# Read input either from pipe or argument
if [ -t 0 ]; then
    # No pipe input, use arguments
    echo -n "$*" > "$TEMP_FILE"
else
    # Input from pipe - stream to temp file
    cat > "$TEMP_FILE"
fi

# Check if input is empty
if [ ! -s "$TEMP_FILE" ]; then
    # Set a single space for empty clipboard
    if ! "$POWERSHELL" -command "Set-Clipboard ' '" 2>&1; then
        echo "Error: Failed to set clipboard" >&2
        exit 1
    fi
else
    # Convert Unix path to Windows path
    WIN_PATH=$(wslpath -w "$TEMP_FILE")

    # Get file size for decision making
    FILE_SIZE=$(stat -c%s "$TEMP_FILE" 2>/dev/null || stat -f%z "$TEMP_FILE" 2>/dev/null || echo "0")

    # For files larger than 10MB, use file-based approach
    if [ "$FILE_SIZE" -gt 10485760 ]; then
        # Use PowerShell to read file directly with UTF-8 encoding
        if ! "$POWERSHELL" -command "Get-Content -Path '$WIN_PATH' -Raw -Encoding UTF8 | Set-Clipboard" 2>&1; then
            echo "Error: Failed to set clipboard from file" >&2
            exit 1
        fi
    else
        # For smaller files, use the same file-based approach
        # This avoids shell escaping issues entirely
        if ! "$POWERSHELL" -command "\$input = Get-Content -Path '$WIN_PATH' -Raw -Encoding UTF8; Set-Clipboard \$input" 2>&1; then
            echo "Error: Failed to set clipboard" >&2
            exit 1
        fi
    fi
fi

if [ -n "$WSL_CLIPBOARD_DEBUG" ]; then
    echo "[$(date)] wl-copy completed successfully" >&2
fi