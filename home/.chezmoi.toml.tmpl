encryption = "age"

[age]
{{- if eq .chezmoi.os "darwin" }}
identity = "{{ .chezmoi.homeDir }}/Library/Application Support/sops/age/keys.txt"
{{- else }}
identity = "{{ .chezmoi.homeDir }}/.config/sops/age/keys.txt"
{{- end }}
recipient = "age1e6gdd6c0nf5p47jhcq8dvrcyu4vmrzvg2kd75thsgyl7pzqemunq9mfl7e"

[cd]
command = "fish"

[data]
email = "enno@nerdworks.de"
name = "Enno Richter"
displayConfig = {{ output (joinPath .chezmoi.sourceDir ".." "scripts" "get-display-config.sh") | quote }}

enableEmail = false
enableSecrets = false

customCABundle = ""
customPyPIIndex = ""

# Enable WSL-specific workarounds and tools
isWSL = false

{{- if eq .chezmoi.os "darwin" }}
# Secretive SSH Agent detection (macOS only)
{{-   $secretiveSocket := joinPath .chezmoi.homeDir "Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh" }}
{{-   $socketExists := stat $secretiveSocket }}
secretiveAvailable = {{ if $socketExists }}true{{ else }}false{{ end }}
secretiveSocketPath = {{ $secretiveSocket | quote }}
{{- else }}
secretiveAvailable = false
secretiveSocketPath = ""
{{- end }}

# available themes: "tokyonight_day", "tokyonight_night", "cyberdream_light", "cyberdream" (dark)
theme = "tokyonight_day"

[secret]
command = "{{ joinPath .chezmoi.sourceDir ".." "scripts" "chesops.sh" }}"
