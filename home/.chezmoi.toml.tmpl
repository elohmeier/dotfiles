encryption = "age"
scriptTempDir = "{{ .chezmoi.homeDir }}/.cache/chezmoi" # /tmp may be mounted noexec

[age]
{{- if eq .chezmoi.os "darwin" }}
identity = "{{ .chezmoi.homeDir }}/Library/Application Support/sops/age/keys.txt"
{{- else }}
identity = "{{ .chezmoi.homeDir }}/.config/sops/age/keys.txt"
{{- end }}
recipient = "age1e6gdd6c0nf5p47jhcq8dvrcyu4vmrzvg2kd75thsgyl7pzqemunq9mfl7e"

[cd]
command = "fish"

[data]
email = {{ promptStringOnce . "email" "Email" "enno@nerdworks.de" | quote }}
githubEmail = {{ promptStringOnce . "githubEmail" "GitHub email (blank to disable)" "2536303+elohmeier@users.noreply.github.com" | quote }}
name = {{ promptStringOnce . "name" "Name" "Enno Richter" | quote }}
ghosttyFontFamily = {{ promptChoiceOnce . "ghosttyFontFamily" "Ghostty font family" (list "Spleen 6x12" "Spleen 8x16") "Spleen 6x12" | quote }}
ghosttyFontSize = {{ promptIntOnce . "ghosttyFontSize" "Ghostty font size" 12 }}

enableEmail = {{ promptBoolOnce . "enableEmail" "Enable email configuration" false }}
enableSecrets = {{ promptBoolOnce . "enableSecrets" "Enable secrets" false }}

{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
customCABundle = "{{ .chezmoi.homeDir }}/.config/ssl/ca-certificates.crt"
{{- else }}
customCABundle = ""
{{- end }}
customPyPIIndex = {{ promptStringOnce . "customPyPIIndex" "Custom PyPI index (blank to disable)" "" | quote }}
{{- $githubMirror := promptStringOnce . "githubMirror" "GitHub mirror URL (blank for github.com)" "" }}
githubMirror = {{ $githubMirror | quote }}
forgejoURL = {{ promptStringOnce . "forgejoURL" "Forgejo URL for tea (blank to disable)" "" | quote }}
woodpeckerURL = {{ promptStringOnce . "woodpeckerURL" "Woodpecker URL for woodpecker-cli (blank to disable)" "" | quote }}

{{- $pushoverUserKey := promptStringOnce . "pushoverUserKey" "Pushover user key (blank to disable agent notifications)" "" }}
pushoverUserKey = {{ $pushoverUserKey | quote }}
{{- if $pushoverUserKey }}
pushoverApiToken = {{ promptStringOnce . "pushoverApiToken" "Pushover application API token" | quote }}
pushoverEncryptionKey = {{ promptStringOnce . "pushoverEncryptionKey" "Pushover E2EE key (64 hex characters, blank to disable)" "" | quote }}
# https://pushover.net/api#sounds
pushoverAgentSound = {{ promptStringOnce . "pushoverAgentSound" "Pushover coding agent sound" "classical" | quote }}
{{- else }}
pushoverApiToken = ""
pushoverEncryptionKey = ""
pushoverAgentSound = ""
{{- end }}

isWSL = {{ and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}

theme = {{ promptChoiceOnce . "theme" "Theme" (list "tokyonight_day" "tokyonight_night" "cyberdream_light" "cyberdream") "tokyonight_day" | quote }}
machineAccent = {{ promptChoiceOnce . "machineAccent" "Machine accent" (list "default" "red" "yellow" "green" "purple") "default" | quote }}

{{- if and $githubMirror (not (stat (joinPath .chezmoi.workingTree ".git" "refs" "remotes"))) }}

# Source is a mirror archive, not a git clone (see scripts/mirror-update.sh)
[update]
command = "bash"
args = [{{ joinPath .chezmoi.workingTree "scripts" "mirror-update.sh" | quote }}, {{ $githubMirror | trimSuffix "/" | quote }}]
{{- end }}

[secret]
command = "{{ joinPath .chezmoi.sourceDir ".." "scripts" "chesops.sh" }}"
