#!/usr/bin/env bash
# mise description="Update a vendored agent skill from its upstream repo"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

skill="${1:?Usage: mise run update-skill <skill-name>}"
skill_dir="home/dot_agents/skills/$skill"

declare -A sources
case "$skill" in
  agent-browser)
    base="https://raw.githubusercontent.com/vercel-labs/agent-browser/refs/heads/main"
    sources=(
      ["SKILL.md"]="$base/skill-data/core/SKILL.md"
      ["references/authentication.md"]="$base/skill-data/core/references/authentication.md"
      ["references/commands.md"]="$base/skill-data/core/references/commands.md"
      ["references/profiling.md"]="$base/skill-data/core/references/profiling.md"
      ["references/proxy-support.md"]="$base/skill-data/core/references/proxy-support.md"
      ["references/session-management.md"]="$base/skill-data/core/references/session-management.md"
      ["references/snapshot-refs.md"]="$base/skill-data/core/references/snapshot-refs.md"
      ["references/video-recording.md"]="$base/skill-data/core/references/video-recording.md"
      ["templates/authenticated-session.sh"]="$base/skill-data/core/templates/authenticated-session.sh"
      ["templates/capture-workflow.sh"]="$base/skill-data/core/templates/capture-workflow.sh"
      ["templates/form-automation.sh"]="$base/skill-data/core/templates/form-automation.sh"
    )
    ;;
  *)
    echo "Unknown skill: $skill"
    echo "Supported: agent-browser"
    exit 1
    ;;
esac

if [[ ! -d "$skill_dir" ]]; then
  echo "Skill directory not found: $skill_dir"
  exit 1
fi

count=0
for file in "${!sources[@]}"; do
  mkdir -p "$skill_dir/$(dirname "$file")"
  echo "Fetching $file..."
  curl -fsSL "${sources[$file]}" -o "$skill_dir/$file"
  count=$((count + 1))
done

echo "Updated $skill ($count files)"
